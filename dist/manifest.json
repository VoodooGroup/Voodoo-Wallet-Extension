{
  "manifest_version": 3,
  "name": "Voodoo Wallet",
  "short_name": "Voodoo Wallet",
  "version": "1.0.6",
  "description": "Voodoo Wallet — PulseChain wallet with VDO staking",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://rpc.pulsechain.com/*",
    "https://pulsechain.publicnode.com/*",
    "https://api.scan.pulsechain.com/*",
    "https://otter.pulsechain.com/*",
    "https://api.coingecko.com/*",
    "https://api.dexscreener.com/*",
    "https://api.geckoterminal.com/*",
    "https://api.livecoinwatch.com/*",
    "https://open.er-api.com/*"
  ],
  "options_ui": {
    "page": "src/fullscreen/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Voodoo Wallet",
    "default_icon": {
      "16": "public/icon16.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "content_scripts": [
    {
      "js": [
        "assets/bridge.js-Cz9IDdYz.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/*",
        "public/*",
        "assets/provider.js-D6HM1G-q.js",
        "assets/bridge.js-Cz9IDdYz.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "assets/provider.js-D6HM1G-q.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
